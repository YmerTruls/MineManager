  m_Script: {fileID: 11500000, guid: d79650d2716ee27449e29279f20ff220, type: 3}
  m_Name: Day 7A
  m_EditorClassIdentifier: 
  message: '"Greetings Foreman F12! Welcome to the M.I.N.E. Corp mining operation!
    \n" +             "To settle in to your new position, we are only giving you
    access to mineshafts A1 and A2 today. \n" +             "We have also delivered
    simple forms that you can give to the worker to send them to a cave, they should
    be on your left.\n" +             "Make sure to reach the daily qouta! M.I.N.E.
    Corp, digging our way to the future!\n"  +             "Daily Qouta:  " + goalQuota.Ore.OreName
    + "  " + goalQuota.OreCount'
  day: 6
